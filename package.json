{
  "name": "project-atmos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wind:fetch && vite",
    "build": "npm run build:only && npm run deploy",
    "build:only": "npm run wind:fetch && vite build",
    "wind:fetch": "node --import ./scripts/loader.mjs scripts/fetch-wind.mjs",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist -b gh -t --nojekyll -m \"Deploy build\" && git fetch -q origin gh && git --no-pager log -1 --format=\"gh branch is now: %h %s (%cr)\" origin/gh"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "gh-pages": "^6.3.0",
    "vite": "^8.2.1"
  }
}
